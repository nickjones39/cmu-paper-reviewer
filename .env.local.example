# Local-model settings for this fork. Copy to .env.local (gitignored) and edit.
# Kept apart from upstream's .env, whose settings class rejects unknown keys.

# What the upload form preselects. Backend ids: ollama, lmstudio, omlx, splash,
# mlx-serve, mlx-lm, mlx-openai-server, llamacpp, vllm, jan, localai, custom.
LOCAL_DEFAULT_BACKEND=splash
LOCAL_DEFAULT_BASE_URL=http://127.0.0.1:8003/v1
LOCAL_DEFAULT_MODEL=mac-studio-default-model
# Optional name shown for the default server (e.g. a gateway in front of Splash/oMLX).
LOCAL_DEFAULT_LABEL=
# Optional context window in tokens (blank = whatever the server reports).
LOCAL_DEFAULT_CONTEXT=

# Seconds to wait for one model response (long prefills on big papers).
LOCAL_LLM_TIMEOUT=1800

# API keys, only for servers that require one. They stay on the server and are
# never sent to the browser. oMLX's key is also read from ~/.omlx/settings.json.
# SPLASH_API_KEY=
# OMLX_API_KEY=
# LMSTUDIO_API_KEY=
# LOCAL_LLM_API_KEY=        # fallback for any backend

# Port for ./run_local.sh (keep clear of 8000/8080, which local servers use).
LOCAL_APP_PORT=8321

# Set to 0 on a public deployment of this fork to hide local mode.
LOCAL_MODELS_ENABLED=1
